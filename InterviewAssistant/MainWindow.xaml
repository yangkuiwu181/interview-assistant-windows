<Window x:Class="InterviewAssistant.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="面试助手" Width="520" Height="790" MinWidth="420" MinHeight="550" Topmost="True" WindowStartupLocation="CenterScreen"
        Background="#0D1726" Foreground="#EFF5FA" FontFamily="Microsoft YaHei UI" Closing="Window_Closing">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <ScrollViewer x:Name="PageScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="PageScrollViewer_PreviewMouseWheel">
  <Grid Margin="18,17,18,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1" CornerRadius="13" Padding="15,13" Margin="0,0,0,13">
      <DockPanel LastChildFill="True">
        <CheckBox x:Name="TopmostCheck" Content="置顶" IsChecked="True" VerticalAlignment="Center" DockPanel.Dock="Right"
                  Checked="TopmostCheck_Changed" Unchecked="TopmostCheck_Changed"/>
        <StackPanel Orientation="Horizontal">
          <Border Width="4" Height="37" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,0,12,0"/>
          <StackPanel>
            <TextBlock Text="面试助手" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="实时听题  ·  屏幕解题" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1" CornerRadius="13" Padding="15" Margin="0,0,0,13">
      <StackPanel>
        <TextBlock Text="01  声音输入" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="1,0,0,7"/>
        <TextBlock Text="会议播放设备" FontSize="15" FontWeight="SemiBold" Margin="1,0,0,8"/>
        <DockPanel>
          <Button x:Name="RefreshDevicesButton" Content="刷新" Style="{StaticResource QuietButtonStyle}" DockPanel.Dock="Right" Click="RefreshDevices_Click" Margin="8,0,0,0"/>
          <ComboBox x:Name="DeviceCombo" MinHeight="30" SelectionChanged="DeviceCombo_SelectionChanged">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FriendlyName}" Foreground="{StaticResource TextBrush}"/></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </DockPanel>
        <Button x:Name="DetectDeviceButton" Content="检测正在播放声音的设备（请让对方说话）" Style="{StaticResource QuietButtonStyle}"
                Click="DetectDevice_Click" HorizontalAlignment="Left" Margin="0,8,0,3"/>
        <TextBlock x:Name="DeviceHintText" Text="检测设备不调用语音识别接口，不产生识别费用。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,1,0,7" FontSize="11"/>
        <ProgressBar x:Name="AudioLevelBar" Minimum="0" Maximum="100" Height="6" Value="0" Margin="2,3,2,8"/>
        <TextBlock x:Name="AudioHintText" Text="声音检测：待机" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,3" FontSize="11"/>
        <TextBlock x:Name="AsrHintText" Text="腾讯云识别：待机" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,3" TextWrapping="Wrap" FontSize="11"/>
        <CheckBox x:Name="RecordMyVoiceCheck" Content="同时记录我的回答（麦克风）" Margin="2,9,0,4"/>
        <DockPanel>
          <Button x:Name="RefreshMicrophonesButton" Content="刷新" Style="{StaticResource QuietButtonStyle}" DockPanel.Dock="Right" Click="RefreshMicrophones_Click" Margin="8,0,0,0"/>
          <ComboBox x:Name="MicrophoneCombo" MinHeight="30" SelectionChanged="MicrophoneCombo_SelectionChanged">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FriendlyName}" Foreground="{StaticResource TextBrush}"/></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </DockPanel>
        <ProgressBar x:Name="MicrophoneLevelBar" Minimum="0" Maximum="100" Height="5" Value="0" Margin="2,7,2,3"/>
        <TextBlock x:Name="MicrophoneHintText" Text="默认关闭；开启会增加一路腾讯云识别用量。建议戴耳机，避免麦克风重复收到面试官声音。"
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,5,0,3" FontSize="11"/>
        <TextBlock Text="播放设备（录制麦克风时也包括麦克风）连续 3 分钟静音会自动暂停。" Foreground="{StaticResource MutedBrush}" Margin="2,3,0,0" FontSize="11" TextWrapping="Wrap"/>
        <DockPanel Margin="0,10,0,0">
          <Button x:Name="StartButton" Content="开始监听" Style="{StaticResource PrimaryButtonStyle}" Click="StartButton_Click" DockPanel.Dock="Left"/>
          <TextBlock x:Name="StatusText" Text="待机" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="7,0,0,0" TextWrapping="Wrap" FontSize="11"/>
        </DockPanel>
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1" CornerRadius="13" Padding="15" Margin="0,0,0,13">
      <StackPanel>
      <TextBlock Text="02  面试问题" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="1,0,0,7"/>
      <TextBlock Text="面试官的问题（可编辑）" FontSize="15" FontWeight="SemiBold" Margin="1,0,0,8"/>
      <TextBox x:Name="QuestionBox" MinHeight="90" MaxHeight="150" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
      <WrapPanel Margin="0,6,0,0">
        <Button x:Name="CaptureScreenButton" Content="截取屏幕题目" Style="{StaticResource QuietButtonStyle}" Click="CaptureScreen_Click"/>
        <Button x:Name="ClearScreenshotButton" Content="移除截图" Style="{StaticResource QuietButtonStyle}" Click="ClearScreenshot_Click" IsEnabled="False"/>
      </WrapPanel>
      <TextBlock x:Name="ScreenshotHintText" Text="需要看投屏题目时，点击截取屏幕题目并框选；截图仅在点击生成回答时发送。"
                 Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,3,0,5" FontSize="11"/>
      <Image x:Name="ScreenshotPreview" Height="90" Stretch="Uniform" HorizontalAlignment="Left" Visibility="Collapsed"/>
      <TextBlock x:Name="InterimText" Foreground="{StaticResource MutedBrush}" Margin="2,5,0,0" TextWrapping="Wrap" FontSize="11"/>
      <TextBlock Text="识别文字会继续补充；等对方说完，再点击“生成回答”。" Foreground="{StaticResource MutedBrush}" Margin="2,5,0,0" TextWrapping="Wrap" FontSize="11"/>
      <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
        <TextBlock Text="回答思考强度" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="ReasoningEffortCombo" Width="132" MinHeight="29" SelectedValuePath="Tag">
          <ComboBoxItem Content="无（最快）" Tag="none"/>
          <ComboBoxItem Content="低" Tag="low"/>
          <ComboBoxItem Content="高" Tag="high"/>
          <ComboBoxItem Content="最高" Tag="max"/>
        </ComboBox>
      </StackPanel>
      <CheckBox x:Name="InterviewMemoryCheck" Content="使用本场面试上下文（最近 5 轮）" Margin="2,10,0,0"/>
      <TextBlock Text="仅关联当前场次；此前答案只帮助理解追问，个人经历以资料为准。开启后会增加模型用量。"
                 Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,4,0,0" FontSize="11"/>
      <WrapPanel Margin="0,11,0,0">
        <Button Content="生成回答" Style="{StaticResource PrimaryButtonStyle}" Click="Generate_Click"/>
        <Button Content="重新生成" Click="Regenerate_Click"/>
        <Button Content="忽略本次" Style="{StaticResource QuietButtonStyle}" Click="Ignore_Click"/>
      </WrapPanel>
      </StackPanel>
    </Border>
    <DockPanel Grid.Row="3" Margin="2,0,0,8">
      <Button Content="复制" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Right" DockPanel.Dock="Right" Click="Copy_Click" Margin="0"/>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="03  回答" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
        <TextBlock Text="回答逐字稿" FontWeight="SemiBold" FontSize="15" Margin="0,3,0,0"/>
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="4" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1" CornerRadius="13" Padding="18" MinHeight="230">
      <TextBlock x:Name="AnswerText" Text="等面试官说完，点击“生成回答”后显示答案。" FontSize="16" LineHeight="28" TextWrapping="Wrap"/>
    </Border>
    <Expander Grid.Row="5" Header="我的口述、资料与记录" Margin="0,13,0,0">
      <TabControl Margin="0,2,0,0">
        <TabItem Header="我的口述">
          <StackPanel Margin="9">
            <TextBlock Text="录到的每句话按面试场次保存在本机，可在这里校正转写。未关联问题的话也会保留。"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="1,0,0,9"/>
            <TextBlock Text="选择面试场次" Foreground="{StaticResource TextBrush}" Margin="1,0,0,5"/>
            <ComboBox x:Name="SpeechSessionCombo" MinHeight="30" SelectionChanged="SpeechSessionCombo_SelectionChanged" Margin="0,0,0,8">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <ListBox x:Name="SpeechList" Height="160" DisplayMemberPath="Display" SelectionChanged="SpeechList_SelectionChanged"/>
            <TextBox x:Name="SpeechEditor" MinHeight="68" MaxHeight="160" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Margin="0,8,0,4"/>
            <WrapPanel>
              <Button x:Name="SaveSpeechButton" Content="保存修正" Click="SaveSpeech_Click" IsEnabled="False"/>
              <Button x:Name="DeleteSpeechButton" Content="删除这句" Style="{StaticResource DangerButtonStyle}" Click="DeleteSpeech_Click" IsEnabled="False"/>
            </WrapPanel>
          </StackPanel>
        </TabItem>
        <TabItem Header="资料">
          <StackPanel Margin="9">
            <TextBlock Text="按用途收纳资料。点击分类展开，导入的文件只会放进该分类。" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="2,0,0,7"/>
            <Expander x:Name="ResumeSection" Header="简历（0）" Foreground="White" Background="#1F2937" Margin="0,0,0,6">
              <StackPanel Margin="10,6,8,8">
                <TextBlock Text="回答中的个人经历以这里的资料为准。" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                <ListBox x:Name="ResumeList" Style="{StaticResource DocumentListStyle}" SelectionChanged="DocumentSelectionChanged">
                  <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="ResumeEmpty" Text="还没有简历文件" Foreground="#9CA3AF" Margin="2,8,0,7"/>
                <WrapPanel>
                  <Button Content="导入简历" Tag="Resume" Click="Import_Click"/>
                  <Button x:Name="ResumeDeleteButton" Content="删除选中" Style="{StaticResource DangerButtonStyle}" Tag="Resume" Click="DeleteDocument_Click" IsEnabled="False"/>
                </WrapPanel>
              </StackPanel>
            </Expander>
            <Expander x:Name="JobSection" Header="岗位 JD（0）" Foreground="White" Background="#1F2937" Margin="0,0,0,6">
              <StackPanel Margin="10,6,8,8">
                <TextBlock Text="用于理解岗位要求，不会被当成你的个人经历。" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                <ListBox x:Name="JobList" Style="{StaticResource DocumentListStyle}" SelectionChanged="DocumentSelectionChanged">
                  <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="JobEmpty" Text="还没有岗位 JD" Foreground="#9CA3AF" Margin="2,8,0,7"/>
                <WrapPanel>
                  <Button Content="导入岗位 JD" Tag="JobDescription" Click="Import_Click"/>
                  <Button x:Name="JobDeleteButton" Content="删除选中" Style="{StaticResource DangerButtonStyle}" Tag="JobDescription" Click="DeleteDocument_Click" IsEnabled="False"/>
                </WrapPanel>
              </StackPanel>
            </Expander>
            <Expander x:Name="KnowledgeSection" Header="自定义资料（0）" Foreground="White" Background="#1F2937">
              <StackPanel Margin="10,6,8,8">
                <TextBlock Text="可放面试题答案、补充经历和你希望沿用的原话。" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                <ListBox x:Name="KnowledgeList" Style="{StaticResource DocumentListStyle}" SelectionChanged="DocumentSelectionChanged">
                  <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="KnowledgeEmpty" Text="还没有自定义资料" Foreground="#9CA3AF" Margin="2,8,0,7"/>
                <WrapPanel>
                  <Button Content="导入自定义资料" Tag="Knowledge" Click="Import_Click"/>
                  <Button x:Name="KnowledgeDeleteButton" Content="删除选中" Style="{StaticResource DangerButtonStyle}" Tag="Knowledge" Click="DeleteDocument_Click" IsEnabled="False"/>
                </WrapPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </TabItem>
        <TabItem Header="记录">
          <StackPanel Margin="9">
            <TextBlock x:Name="CurrentSessionText" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,5"/>
            <WrapPanel Margin="0,0,0,6">
              <Button Content="开始新面试" Style="{StaticResource PrimaryButtonStyle}" Click="NewSession_Click"/>
              <Button x:Name="EndSessionButton" Content="结束本场" Click="EndSession_Click"/>
            </WrapPanel>
            <TextBlock Text="选择面试场次" Foreground="White" Margin="2,0,0,4"/>
            <ComboBox x:Name="SessionCombo" MinHeight="30" SelectionChanged="SessionCombo_SelectionChanged">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="场次名称（可修改）" Foreground="#9CA3AF" Margin="2,8,0,4"/>
            <TextBox x:Name="SessionTitleBox" LostFocus="SessionTitleBox_LostFocus"/>
            <TextBlock x:Name="LatencyStatsText" Foreground="White" Margin="0,0,0,5"/>
            <ListBox x:Name="HistoryList" DisplayMemberPath="Question" Height="145" SelectionChanged="HistoryList_SelectionChanged"/>
            <TextBlock x:Name="HistoryEmptyText" Text="这场面试还没有问答记录" Foreground="#9CA3AF" Margin="2,5,0,5"/>
            <TextBlock Text="所选问题中我的实际口述" Foreground="White" Margin="2,8,0,4"/>
            <TextBlock x:Name="SelectedSpokenText" Text="尚无录到的口述" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,9"/>
            <Button x:Name="DeleteSessionButton" Content="删除所选场次及其问答" Style="{StaticResource DangerButtonStyle}" Click="DeleteSession_Click" HorizontalAlignment="Left"/>
          </StackPanel>
        </TabItem>
        <TabItem Header="AI 回答">
          <StackPanel Margin="9">
            <TextBlock Text="AI 回答要求" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="1,0,0,5"/>
            <TextBlock Text="一条要求写在一个框里。可调整顺序；修改后自动保存，下次生成回答时生效。"
                       Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="1,0,0,11"/>
            <ItemsControl x:Name="AnswerRulesItems">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                          BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,0,0,9">
                    <StackPanel>
                      <DockPanel LastChildFill="False" Margin="0,0,0,7">
                        <WrapPanel DockPanel.Dock="Right">
                          <Button Content="上移" Style="{StaticResource QuietButtonStyle}" Click="MoveRuleUp_Click" IsEnabled="{Binding CanMoveUp}" MinHeight="27" Padding="8,4"/>
                          <Button Content="下移" Style="{StaticResource QuietButtonStyle}" Click="MoveRuleDown_Click" IsEnabled="{Binding CanMoveDown}" MinHeight="27" Padding="8,4"/>
                          <Button Content="删除" Style="{StaticResource DangerButtonStyle}" Click="DeleteRule_Click" MinHeight="27" Padding="8,4" Margin="0"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                      </DockPanel>
                      <TextBox x:Name="RuleEditor" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="RuleTextChanged"
                               MinHeight="68" MaxHeight="180" MaxLength="2000" AcceptsReturn="True"
                               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="RulesEmptyText" Text="暂无回答要求。点击“新增一条”添加。"
                       Foreground="{StaticResource MutedBrush}" Margin="2,2,0,11"/>
            <WrapPanel Margin="0,3,0,0">
              <Button Content="新增一条" Style="{StaticResource PrimaryButtonStyle}" Click="AddRule_Click"/>
              <Button Content="恢复预设要求" Style="{StaticResource QuietButtonStyle}" Click="RestoreRules_Click"/>
            </WrapPanel>
          </StackPanel>
        </TabItem>
        <TabItem Header="API 设置">
          <StackPanel Margin="9">
            <TextBlock Text="服务连接" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="1,0,0,5"/>
            <TextBlock Text="密钥保存在当前 Windows 用户的安全存储中。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="1,0,0,11"/>
            <TextBlock Text="腾讯云 AppID" Foreground="White"/><TextBox x:Name="AppIdBox" Margin="0,3,0,9"/>
            <TextBlock Text="腾讯云 SecretID" Foreground="White"/><TextBox x:Name="SecretIdBox" Margin="0,3,0,9"/>
            <TextBlock Text="腾讯云 SecretKey" Foreground="White"/><PasswordBox x:Name="SecretKeyBox" Margin="0,3,0,9"/>
            <TextBlock Text="DeepSeek API Key" Foreground="White"/><PasswordBox x:Name="DeepSeekKeyBox" Margin="0,3,0,9"/>
            <Button Content="保存设置" Style="{StaticResource PrimaryButtonStyle}" Click="SaveSettings_Click" HorizontalAlignment="Left"/>
          </StackPanel>
        </TabItem>
      </TabControl>
    </Expander>
  </Grid>
  </ScrollViewer>
</Window>
