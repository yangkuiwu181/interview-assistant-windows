<Window x:Class="InterviewAssistant.ScreenCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="框选屏幕题目" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="Manual" ShowInTaskbar="False" Topmost="True"
        Background="#0D1726" KeyDown="Window_KeyDown">
  <Grid>
    <Image x:Name="ScreenshotImage" Stretch="Fill" IsHitTestVisible="False"/>
    <Canvas x:Name="SelectionLayer" Background="Transparent"
            MouseLeftButtonDown="SelectionLayer_MouseLeftButtonDown"
            MouseMove="SelectionLayer_MouseMove"
            MouseLeftButtonUp="SelectionLayer_MouseLeftButtonUp"
            MouseRightButtonDown="SelectionLayer_MouseRightButtonDown">
      <Rectangle x:Name="SelectionRectangle" Visibility="Collapsed"
                 Stroke="#65D4C8" StrokeThickness="3" Fill="#2265D4C8"/>
    </Canvas>
    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12"
            Background="#EC17263B" CornerRadius="10" Padding="15,10" IsHitTestVisible="False">
      <TextBlock Text="拖动鼠标框选题目和表结构 · Esc 或右键取消"
                 Foreground="White" FontFamily="Microsoft YaHei UI" FontSize="16"/>
    </Border>
  </Grid>
</Window>
